# This is Git's per-user configuration file.
[user]
    name = Beomsoo Jang
    email = norangmangto@gmail.com

[core]
    editor = /usr/bin/vim
    pager = delta

[interactive]
    diffFilter = delta --color-only

[alias]
    plog = log --graph --pretty='format:%C(red)%d%C(reset) %C(yellow)%h%C(reset) %ar %C(green)%aN%C(reset) %s'
    glog = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
    glog-all = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)' --all

    aa = add --all
    aap = add --all -p
    ap = add -p
    # br = branch
    br = branch --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(contents:subject) %(color:green)(%(committerdate:relative)) [%(authorname)]' --sort=-committerdate
    bra = branch -a
    brd = branch -D
    cb = checkout -b
    ci = commit -v
    cia = commit -v --amend
    cim = commit -m
    cl = clone
    co = checkout
    di = diff
    fta = fetch --all -t -p
    pl = pull
    ps = push
    psf = push --force-with-lease
    res = reset --hard
    rv = remote -v
    st = status -sb
    sts = stash

[push]
    autoSetupRemote = true

[pull]
    rebase = true

[merge]
    conflictstyle = diff3

[url "ssh://git@github.com"]
    insteadOf = https://github.com

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[delta]
    #syntax-theme = Dracula   # 또는 Nord, OneHalfDark 등
    syntax-theme = "Coldark-Dark" # 또는 Nord, OneHalfDark 등
    navigate = true      # n/N으로 diff 섹션 이동
    side-by-side = true  # 좌우 분할 diff
    line-numbers = true  # 라인 번호 표시

