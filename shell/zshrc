# Minimal zshrc: oh-my-zsh + zsh aliases. Symlinked to ~/.zshrc by install.py.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
)
[ -f "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

[ -f "$HOME/.zsh_alias" ] && source "$HOME/.zsh_alias"

export EDITOR=nvim
export VISUAL=nvim

if command -v uv >/dev/null 2>&1; then
  eval "$(uv generate-shell-completion zsh)"
fi

# Docker Desktop
[ -f "$HOME/.docker/init-zsh.sh" ] && source "$HOME/.docker/init-zsh.sh"

# Don't share history live across sessions; write on exit only.
unsetopt share_history

# kaf / protokaf
[ -f "$HOME/opt/protokaf.sh" ] && source "$HOME/opt/protokaf.sh"

# kubectl completion
[[ $commands[kubectl] ]] && source <(kubectl completion zsh)

# dbt (installed to ~/.local/bin by the dbt installer, not by this repo)
if [ -d "$HOME/.local/bin" ]; then
  export PATH="$PATH:$HOME/.local/bin"
  alias dbtf="$HOME/.local/bin/dbt"
fi
